# SpatialCanvas AI - Environment Configuration

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=spatialcanvas-ai-hackathon
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash

# Optional: Google AI Studio / Gemini API Key (runs in high-fidelity mock if omitted)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
PREDICTIVE_LATENCY_MS=15
DEFAULT_SCENE=g1_farmhouse

