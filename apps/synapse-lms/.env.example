# Synapse LMS Environment Template
# Copy this file to .env before starting services

# Django / Wagtail Backend Configuration
DJANGO_SECRET_KEY=replace_with_secure_django_secret_key_minimum_50_chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB=synapse_lms_db
POSTGRES_USER=synapse_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://synapse_admin:replace_with_secure_postgres_password@localhost:5432/synapse_lms_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4203

# Angular Frontend Configuration
NG_APP_API_BASE_URL=http://localhost:8000/api/v1
NG_APP_TENANT_ID=cyber-academy
NG_APP_AUDIO_ENABLED=true
